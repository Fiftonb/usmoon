# 内置 API 配置（可选）
# 复制此文件为 .env.local 并填入真实的 API 配置

# OpenAI API Key（必填）
OPENAI_API_KEY=your_api_key_here

# OpenAI Base URL（可选，默认为 https://api.openai.com/v1）
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Model（可选，默认为 gpt-3.5-turbo）
OPENAI_MODEL=gpt-3.5-turbo

# 注意：
# 1. 将此文件复制为 .env.local 并填入真实的API配置
# 2. .env.local 文件不会被git跟踪，保护您的密钥安全
# 3. 用户可以在设置中选择使用内置API或自定义API配置
